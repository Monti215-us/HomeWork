filebeat.inputs:

  - type: filestream
    id: nginx-access
    enabled: true

    paths:
      - /var/log/nginx/access.log

  - type: filestream
    id: nginx-error
    enabled: true

    paths:
      - /var/log/nginx/error.log


output.elasticsearch:
  hosts:
    - "http://elastic.ru-central1.internal:9200"

  username: "elastic"
  password: "{{ elastic_password }}"