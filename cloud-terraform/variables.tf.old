/* в данном файле содержаться переменные, которые используются в других местах. Схема записи переменной следующая:  
variable "имя_переменной" {
  type    = тип_переменной
  default = "значение_переменной"
}
*/

variable "cloud_id" {
  type    = string
  default = "<вставить_переменную>"
}

variable "folder_id" {
  type    = string
  default = "<вставить_переменную>"
}

variable "flow" {
  type    = string
  default = "24-01"
}